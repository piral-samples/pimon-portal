{
  "private": true,
  "version": "0.1.0",
  "name": "@smapiot/pimon-portal-shell",
  "description": "The portal's shell.",
  "keywords": [
    "piral"
  ],
  "scripts": {
    "start": "piral debug --env ../../../.env",
    "build": "piral build --type release --public-url \"/_/pimon-portal\" --env ../../../.env",
    "publish": "node ../../../scripts/publish-shell.mjs",
    "declaration": "piral declaration"
  },
  "app": "./src/index.html",
  "types": "dist/index.d.ts",
  "importmap": {
    "imports": {
      "@emotion/react": ".",
      "@mantine/core": ".",
      "@mantine/hooks": ".",
      "@tabler/icons-react": ".",
      "@smapiot/pimon-portal-lib": ".",
      "swr": "."
    },
    "inherit": [
      "piral-base",
      "piral-core",
      "piral"
    ]
  },
  "dependencies": {
    "@smapiot/pimon-portal-lib": "0.1.0",
    "piral": "1.12.3",
    "piral-auth": "1.12.3",
    "piral-base": "1.12.3",
    "piral-core": "1.12.3",
    "piral-fetch": "1.12.3",
    "swr": "2.2.0"
  },
  "devDependencies": {}
}
